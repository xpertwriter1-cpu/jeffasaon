<div class="row g-4"><% [{n:'Daycare',d:'A nurturing daily routine with care, play and rest.'},{n:'Playgroup',d:'Social skills, language, movement and creative exploration.'},{n:'PP1',d:'Early literacy, numeracy, confidence and curiosity.'},{n:'PP2',d:'Strengthening foundational skills for the next learning step.'}].forEach(p=>{ %>
<div class="col-md-6"><article class="feature"><h2 class="h3"><%= p.n %></h2><p><%= p.d %></p><p class="small">Complete your child's details, guardian contacts, health information and supporting documents for <%= p.n %>.</p><a class="btn btn-primary rounded-pill" href="/parent/admission?classLevel=<%= encodeURIComponent(p.n) %>">Apply for <%= p.n %></a></article></div><% }) %></div>
