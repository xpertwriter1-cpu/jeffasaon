<%- include('../partials/header') %><section class="container section print-document"><div class="no-print mb-4"><button class="btn btn-primary" type="button" data-print>Print / Save as PDF</button> <a href="<%= currentUser.role==='parent'?'/parent/payments':'/admin/payments' %>">Back to payments</a></div>
<h1><%= school.name %></h1><h2 class="h3">Payment receipt</h2><p><%= school.location %> · <%= school.phone %></p><p><strong>Receipt number:</strong> JPS-<%= String(payment._id).toUpperCase() %><br><strong>Verified on:</strong> <%= new Date(payment.verifiedAt||payment.createdAt).toLocaleDateString('en-KE',{timeZone:'Africa/Nairobi'}) %></p>
<div class="table-card"><p><strong>Parent:</strong> <%= payment.parentName %><br><strong>Student:</strong> <%= payment.student?payment.student.firstName+' '+payment.student.lastName:'Unlinked payment' %><br><strong>Admission number:</strong> <%= payment.student?payment.student.admissionNumber||'Not assigned':'Not available' %></p>
<p><strong>Term:</strong> <%= payment.invoice?payment.invoice.year+' / Term '+payment.invoice.term:'Legacy payment without term invoice' %><br><strong>Method:</strong> <%= payment.method %><br><strong>Transaction reference:</strong> <%= payment.reference||'Cash' %></p><h2 class="h3">Received: KSh <%= payment.amount.toLocaleString('en-KE',{minimumFractionDigits:2}) %></h2><p class="mb-0">Status: Verified paid</p></div>
</section><%- include('../partials/footer') %>
