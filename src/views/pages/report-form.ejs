<%- include('../partials/header') %><section class="container section narrow-wide"><h1><%= report?'Edit':'New' %> student report</h1><p><a href="/admin/reports">Back to reports</a></p>
<form class="form-card" action="/admin/reports<%= report?'/'+report._id:'' %>" method="post"><input type="hidden" name="_csrf" value="<%= recordToken %>"><div class="row g-3">
<div class="col-md-6"><label for="studentId" class="form-label"><%= report ? 'Student' : 'Admitted or active student' %></label><select id="studentId" name="studentId" class="form-select" required><option value="">Choose student</option><% students.forEach(st=>{ %><option value="<%= st._id %>" <%= report && String(report.student)===String(st._id)?'selected':'' %>><%= st.firstName %> <%= st.lastName %> — <%= st.classLevel %></option><% }) %></select></div>
<div class="col-md-3"><label for="year" class="form-label">Year</label><input id="year" name="year" class="form-control" type="number" min="2000" max="2100" value="<%= report?report.year:new Date().getFullYear() %>" required></div>
<div class="col-md-3"><label for="term" class="form-label">Term</label><select id="term" name="term" class="form-select"><% [1,2,3].forEach(t=>{ %><option value="<%= t %>" <%= report && report.term===t?'selected':'' %>>Term <%= t %></option><% }) %></select></div></div>
<h2 class="h4 mt-4">Learning and development</h2><% areas.forEach((area,i)=>{ const assessment=report && report.assessments.find(a=>a.area===area); %><div class="mb-3"><label for="rating<%= i %>" class="form-label"><%= area %></label><select id="rating<%= i %>" name="rating<%= i %>" class="form-select" required><option value="">Choose rating</option><% ratings.forEach(rating=>{ %><option <%= assessment && assessment.rating===rating?'selected':'' %>><%= rating %></option><% }) %></select></div><% }) %>
<div class="row g-3"><div class="col-md-6"><label for="daysPresent" class="form-label">Days present</label><input id="daysPresent" name="daysPresent" type="number" min="0" max="366" class="form-control" value="<%= report?report.daysPresent:'' %>" required></div><div class="col-md-6"><label for="daysPossible" class="form-label">Possible school days</label><input id="daysPossible" name="daysPossible" type="number" min="0" max="366" class="form-control" value="<%= report?report.daysPossible:'' %>" required></div></div>
<div class="my-3"><label for="comments" class="form-label">Teacher comments</label><textarea id="comments" name="comments" rows="5" maxlength="3000" class="form-control"><%= report?report.comments||'':'' %></textarea></div><button class="btn btn-primary">Save draft</button><p class="small mt-2 mb-0">Parents can view this report after an administrator approves it.</p>
</form></section><%- include('../partials/footer') %>
