<%- include('../partials/header') %><section class="container section print-document"><div class="no-print mb-4"><button class="btn btn-primary" type="button" data-print>Print / Save as PDF</button> <a href="<%= currentUser.role==='parent'?'/parent/reports':'/admin/reports' %>">Back to reports</a></div>
<h1><%= school.name %></h1><h2 class="h3">Student progress report</h2><p><%= school.location %> · <%= school.phone %></p><% if(report.status!=='Published') { %><div class="notice mb-3">DRAFT — awaiting school approval</div><% } %>
<div class="table-card"><h2 class="h4"><%= report.student.firstName %> <%= report.student.lastName %></h2><p><strong>Admission number:</strong> <%= report.student.admissionNumber||'Not assigned' %><br><strong>Class:</strong> <%= report.classLevel %><br><strong>Year:</strong> <%= report.year %> · <strong>Term:</strong> <%= report.term %></p>
<table class="table"><thead><tr><th>Learning area</th><th>Assessment</th></tr></thead><tbody><% report.assessments.forEach(a=>{ %><tr><td><%= a.area %></td><td><%= a.rating %></td></tr><% }) %></tbody></table>
<p><strong>Attendance:</strong> <%= report.daysPresent %> of <%= report.daysPossible %> school days</p><h3 class="h5">Teacher comments</h3><p class="report-comments"><%= report.comments||'No additional comments.' %></p><p><strong>Teacher:</strong> <%= report.teacher?report.teacher.name:'School teacher' %></p>
<% if(report.status==='Published') { %><p><strong>Approved by:</strong> <%= report.approvedBy?report.approvedBy.name:'School administrator' %><br><strong>Published:</strong> <%= new Date(report.publishedAt).toLocaleDateString('en-KE',{timeZone:'Africa/Nairobi'}) %></p><% } %></div>
</section><%- include('../partials/footer') %>
