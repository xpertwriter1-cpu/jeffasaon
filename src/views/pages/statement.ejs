<%- include('../partials/header') %><section class="container section print-document">
<div class="no-print mb-4"><button class="btn btn-primary" type="button" data-print>Print / Save as PDF</button> <a href="<%= staff?'/admin/fees':'/parent/fees' %>">Back to fees</a></div>
<h1><%= school.name %></h1><h2 class="h3">Student fee statement</h2><p><%= school.location %> · <%= school.phone %></p><h2 class="h4"><%= student.firstName %> <%= student.lastName %></h2><p><%= student.classLevel %> · Admission no. <%= student.admissionNumber||'Not assigned' %><br>Statement date: <%= new Date().toLocaleDateString('en-KE',{timeZone:'Africa/Nairobi'}) %></p>
<% let totalCents=0, paidCents=0; %><h3 class="h5">Term balances</h3><table class="table"><thead><tr><th>Year / term</th><th>Invoiced (KSh)</th><th>Verified paid (KSh)</th><th>Balance (KSh)</th></tr></thead><tbody>
<% invoices.forEach(inv=>{const t=invoiceTotals(inv,payments);totalCents+=Math.round(t.total*100);paidCents+=Math.round(t.paid*100); %><tr><td><%= inv.year %> / Term <%= inv.term %></td><td><%= t.total.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td><td><%= t.paid.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td><td><%= t.balance.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td></tr><% }) %>
</tbody><tfoot><tr><th>Total</th><th><%= (totalCents/100).toLocaleString('en-KE',{minimumFractionDigits:2}) %></th><th><%= (paidCents/100).toLocaleString('en-KE',{minimumFractionDigits:2}) %></th><th><%= ((totalCents-paidCents)/100).toLocaleString('en-KE',{minimumFractionDigits:2}) %></th></tr></tfoot></table>
<h3 class="h5 mt-4">Payment history</h3><table class="table"><thead><tr><th>Submitted</th><th>Method / reference</th><th>Amount (KSh)</th><th>Status</th></tr></thead><tbody><% payments.forEach(p=>{ %><tr><td><%= new Date(p.createdAt).toLocaleDateString('en-KE',{timeZone:'Africa/Nairobi'}) %></td><td><%= p.method %> / <%= p.reference||'Cash' %><% if(!p.invoice) { %> (Unlinked)<% } %></td><td><%= p.amount.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td><td><%= p.status %></td></tr><% }) %></tbody></table>
<p>Only verified payments linked to a term invoice reduce the balances above. Refunded and pending payments are excluded. Negative balances show a credit.</p>
</section><%- include('../partials/footer') %>
