<%- include('../partials/header') %><section class="container section"><h1>Staff accounts</h1><a href="/admin/dashboard">← Dashboard</a><div class="row g-4 mt-1"><div class="col-lg-5"><form class="form-card" method="post" action="/admin/users"><input type="hidden" name="_security" value="<%= typeof securityToken !== 'undefined' ? securityToken : '' %>"><h2 class="h4">Create staff account</h2><p>Choose the staff member's actual role; they must select this same role when signing in.</p><div class="mb-3"><label class="form-label">Full name</label><input class="form-control" name="name" required></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required></div><div class="mb-3"><label class="form-label">Phone</label><input class="form-control" name="phone"></div><div class="mb-3"><label class="form-label">Role</label><select class="form-select" name="role"><option value="teacher">Teacher — student reports</option><option value="bursar">Bursar — fees and payments</option><option value="admin">Admin — full access</option></select></div><div class="mb-3"><label class="form-label">Temporary password (8+ characters)</label><input class="form-control" type="password" name="password" minlength="8" required></div><button class="btn btn-primary rounded-pill w-100">Create staff account</button></form></div><div class="col-lg-7"><div class="table-card"><h2 class="h4">Current accounts</h2><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td></tr><% }) %></tbody></table></div></div></div></div></section><%- include('../partials/footer') %>
