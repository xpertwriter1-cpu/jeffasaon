<%- include('../partials/header') %><section class="container section narrow"><div class="form-card"><span class="eyebrow">Welcome back</span><h1>Sign in</h1><p>Choose the role assigned to your account. Admin, teacher and bursar accounts are created by the school administrator.</p><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/auth/login"><input type="hidden" name="_security" value="<%= typeof securityToken !== 'undefined' ? securityToken : '' %>"><div class="mb-3"><label class="form-label" for="role">Sign in as</label><select class="form-select" id="role" name="role" required><option value="" <%= selectedRole ? '' : 'selected' %> disabled>Choose your account type</option><option value="admin" <%= selectedRole==='admin' ? 'selected' : '' %>>Admin — full access</option><option value="parent" <%= selectedRole==='parent' ? 'selected' : '' %>>Parent — family portal</option><option value="teacher" <%= selectedRole==='teacher' ? 'selected' : '' %>>Teacher — student reports</option><option value="bursar" <%= selectedRole==='bursar' ? 'selected' : '' %>>Bursar — fees and payments</option></select></div><div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" id="email" type="email" name="email" required></div><div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control" id="password" type="password" name="password" required></div><button class="btn btn-primary rounded-pill w-100">Sign in</button></form><div class="mt-3" id="accountHelp" aria-live="polite"><p id="parentAccountHelp" <%= selectedRole && selectedRole!=='parent' ? 'hidden' : '' %>>Are you a parent without an account? <a href="/auth/register">Create a parent account</a></p><p id="adminAccountHelp" <%= selectedRole==='admin' ? '' : 'hidden' %>>Admin accounts cannot be self-registered. Contact your school administrator to create an account.</p><p id="teacherAccountHelp" <%= selectedRole==='teacher' ? '' : 'hidden' %>>Teacher accounts are created by an Admin. Ask your school administrator to create your account.</p><p id="bursarAccountHelp" <%= selectedRole==='bursar' ? '' : 'hidden' %>>Bursar accounts are created by an Admin. Ask your school administrator to create your account.</p><p id="chooseAccountHelp" <%= selectedRole ? 'hidden' : '' %>>Select an account type to see registration information.</p></div></div></section><%- include('../partials/footer') %>
