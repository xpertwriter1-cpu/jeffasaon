<%- include('../partials/header') %><section class="container section"><h1>Student reports</h1><div class="d-flex gap-3 mb-4"><a href="<%= staff?'/admin/dashboard':'/parent/dashboard' %>">Dashboard</a><% if(staff) { %><a class="btn btn-primary" href="/admin/reports/new">Create report</a><% } %></div>
<p><%= staff?'Teachers prepare drafts. Admins review and publish reports for parents.':'View and print the reports approved by the school.' %></p><div class="table-card table-responsive"><table class="table"><thead><tr><th>Student</th><th>Year / term</th><th>Teacher</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<% reports.forEach(report=>{ %><tr><td><%= report.student?report.student.firstName+' '+report.student.lastName:'Student unavailable' %></td><td><%= report.year %> / Term <%= report.term %></td><td><%= report.teacher?report.teacher.name:'School teacher' %></td><td><%= report.status %></td><td><a href="<%= staff?'/admin':'/parent' %>/reports/<%= report._id %>">View / print</a>
<% if(staff && report.status==='Draft' && (currentUser.role==='admin' || (report.teacher && String(report.teacher._id)===currentUser.id))) { %><a class="d-block" href="/admin/reports/<%= report._id %>/edit">Edit draft</a><% } %>
<% if(staff && currentUser.role==='admin') { %><form class="mt-2" action="/admin/reports/<%= report._id %>/<%= report.status==='Draft'?'publish':'unpublish' %>" method="post"><input type="hidden" name="_csrf" value="<%= recordToken %>"><button class="btn btn-sm btn-outline-primary"><%= report.status==='Draft'?'Approve and publish':'Return to draft' %></button></form><% } %></td></tr><% }) %>
</tbody></table><% if(!reports.length) { %><p>No <%= staff?'':'published ' %>reports yet.</p><% } %></div></section><%- include('../partials/footer') %>
