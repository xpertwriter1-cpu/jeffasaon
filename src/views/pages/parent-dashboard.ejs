<%- include('../partials/header') %><section class="container section"><span class="eyebrow">Your family portal</span><h1>Hello, <%= currentUser.name.split(' ')[0] %>.</h1><p>Follow your children's fees and learning progress.</p>
<div class="d-flex flex-wrap gap-3 my-4"><a class="btn btn-primary" href="/parent/admission">Apply for admission</a><a class="btn btn-outline-primary" href="/parent/fees">Fee balances</a><a class="btn btn-outline-primary" href="/parent/payments">Payments and receipts</a><a class="btn btn-outline-primary" href="/parent/reports">Student reports</a></div>
<div class="table-card"><h2 class="h4">Your children</h2><% if(!students.length) { %><p>No applications yet. <a href="/parent/admission">Apply here.</a></p><% } else { %><div class="table-responsive"><table class="table"><thead><tr><th>Child</th><th>Programme</th><th>Status</th><th>Admission no.</th></tr></thead><tbody><% students.forEach(st=>{ %><tr><td><a href="/parent/students/<%= st._id %>"><%= st.firstName %> <%= st.lastName %></a><small class="d-block"><%= st.status==='Pending'?(st.enrolmentAcceptedAt?'Agreement recorded; awaiting school review':'Accept enrolment or view application'):(st.status==='Admitted'?'Admitted: view fees and pay':'View admission record') %></small></td><td><%= st.classLevel %></td><td><%= st.status %></td><td><%= st.admissionNumber||'Pending' %></td></tr><% }) %></tbody></table></div><% } %></div>
<div class="table-card mt-4"><h2 class="h4">Recent payments</h2><% if(!payments.length) { %><p>No payments yet.</p><% } %><% payments.slice(0,5).forEach(p=>{ %><p>KSh <%= p.amount.toLocaleString('en-KE') %> · <%= p.status %></p><% }) %></div>
</section><%- include('../partials/footer') %>
