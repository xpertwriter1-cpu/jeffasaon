PORT=3000
NODE_ENV=development
DATABASE_URL=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/jeffersons_preschool?retryWrites=true&w=majority
SESSION_SECRET=replace_this_with_a_long_random_secret
SCHOOL_NAME=Jeffersons Preschool
SCHOOL_PHONE=0729 323301
SCHOOL_EMAIL=jeffersonspreschool@gmail.com
SCHOOL_LOCATION=Exciting, Rongai, Kenya
PAYMENT_MODE=manual

# Sandbox testing only; live M-Pesa collection is not enabled by this integration.
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Public HTTPS origin forwarding to this app, with no path or trailing slash.
MPESA_CALLBACK_BASE_URL=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
ENQUIRY_NOTIFY_EMAIL=

# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
# Required only when running npm run seed; use a unique password.
SEED_ADMIN_PASSWORD=
