<%- include('../partials/header') %><section class="container section"><h1>Fees and payments</h1><div class="d-flex gap-3 mb-4"><a href="/parent/dashboard">Dashboard</a><a href="/parent/fees">View fee balances</a></div>
<%- include('../partials/mpesa-sandbox') %>
<p>Pay using the school's official instructions, then submit the payment here for bursar verification.</p><div class="row g-4"><div class="col-lg-5"><div class="form-card"><h2 class="h4">Record a payment</h2>
<% if(error) { %><div class="alert alert-danger"><%= error %></div><% } %><% if(!invoices.length) { %><p>The school must admit your child and create a term invoice before you can submit a payment.</p><% } else { %>
<form method="post" action="/parent/payments"><input type="hidden" name="_csrf" value="<%= recordToken %>">
<div class="mb-3"><label for="invoiceId" class="form-label">Student and term invoice</label><select id="invoiceId" class="form-select" name="invoiceId" required><option value="">Choose invoice</option><% invoices.forEach(inv=>{ const totals=invoiceTotals(inv,payments); %><option value="<%= inv._id %>" <%= String(inv._id)===selectedInvoice?'selected':'' %>><%= inv.student.firstName %> <%= inv.student.lastName %> · <%= inv.year %> Term <%= inv.term %> · Balance KSh <%= totals.balance.toLocaleString('en-KE') %></option><% }) %></select></div>
<div class="mb-3"><label for="amount" class="form-label">Amount paid (KSh)</label><input id="amount" class="form-control" type="number" name="amount" min="1" max="10000000" step="0.01" required></div>
<div class="mb-3"><label for="method" class="form-label">Method</label><select id="method" name="method" class="form-select"><option>M-Pesa</option><option>Bank transfer</option><option>Cash</option></select></div>
<div class="mb-3"><label for="reference" class="form-label">Transaction reference</label><input id="reference" name="reference" class="form-control" maxlength="100"><small>Required for M-Pesa and bank transfer. Use the reference from your confirmation.</small></div>
<div class="mb-3"><label for="parentPhone" class="form-label">Parent phone</label><input id="parentPhone" name="parentPhone" class="form-control" value="<%= currentUser.phone||'' %>" required></div><button class="btn btn-primary">Submit for verification</button></form><% } %>
<div class="notice mt-3">This form records a payment you have already made. Never enter your M-Pesa PIN. Pending payments do not reduce your balance.</div></div></div>
<div class="col-lg-7"><div class="table-card"><h2 class="h4">Payment history</h2><% if(!payments.length) { %><p>No payments recorded.</p><% } %><div class="table-responsive"><table class="table"><thead><tr><th>Date / student</th><th>Amount</th><th>Reference</th><th>Status / receipt</th></tr></thead><tbody>
<% payments.forEach(p=>{ %><tr><td><%= new Date(p.createdAt).toLocaleDateString('en-KE',{timeZone:'Africa/Nairobi'}) %><small class="d-block"><%= p.student?p.student.firstName+' '+p.student.lastName:'Legacy unlinked payment' %></small><% if(p.invoice) { %><small><%= p.invoice.year %> Term <%= p.invoice.term %></small><% } %></td><td>KSh <%= p.amount.toLocaleString('en-KE') %></td><td><%= p.method %><small class="d-block"><%= p.reference||'Cash' %></small></td><td><%= p.status %><% if(p.status==='Paid' && p.student) { %><a class="d-block" href="/parent/payments/<%= p._id %>/receipt">Print receipt</a><% } %></td></tr><% }) %>
</tbody></table></div></div></div></div></section><%- include('../partials/footer') %>
