<%- include('../partials/header') %><section class="container section">
<h1><%= staff?'Term fee invoices':'Your fee balances' %></h1><div class="d-flex gap-3 mb-4"><a href="<%= staff?'/admin/dashboard':'/parent/dashboard' %>">Dashboard</a><a href="<%= staff?'/admin/payments':'/parent/payments' %>">Payments and receipts</a></div>
<p>Only verified payments reduce balances. A negative balance is a credit for that invoice. Unlinked older payments are not included.</p>
<div class="d-flex flex-wrap gap-3 mb-4"><% students.forEach(st=>{ %><a href="<%= staff?'/admin':'/parent' %>/fees/<%= st._id %>/statement">Print statement: <%= st.firstName %> <%= st.lastName %></a><% }) %></div>
<% if(staff) { %><div class="form-card mb-4"><h2 class="h4">Create a term invoice</h2><form action="/admin/fees" method="post"><input type="hidden" name="_csrf" value="<%= recordToken %>"><div class="row g-3">
<div class="col-md-6"><label for="studentId" class="form-label">Admitted or active student</label><select id="studentId" name="studentId" class="form-select" required><option value="">Choose student</option><% invoiceStudents.forEach(st=>{ %><option value="<%= st._id %>"><%= st.firstName %> <%= st.lastName %> — <%= st.classLevel %></option><% }) %></select></div>
<div class="col-md-3"><label for="year" class="form-label">Year</label><input id="year" name="year" class="form-control" type="number" min="2000" max="2100" value="<%= new Date().getFullYear() %>" required></div>
<div class="col-md-3"><label for="term" class="form-label">Term</label><select id="term" name="term" class="form-select"><% [1,2,3].forEach(t=>{ %><option value="<%= t %>">Term <%= t %></option><% }) %></select></div>
<% ['Tuition','Meals','Transport','Admission fee','Uniform','Other'].forEach((label,i)=>{ %><div class="col-md-4"><label for="fee<%= i %>" class="form-label"><%= label %> (KSh)</label><input id="fee<%= i %>" name="fee<%= i %>" class="form-control" type="number" min="0" max="10000000" step="0.01" value="0" required></div><% }) %>
</div><button class="btn btn-primary mt-3" <%= invoiceStudents.length ? '' : 'disabled' %>>Create invoice</button><p class="small mt-2 mb-0">One invoice per student and term. Enter the school's actual fees. Only admitted or active students are eligible.</p></form></div><% } %>
<% if(!invoices.length) { %><div class="notice">No term invoices have been created yet.</div><% } %>
<% invoices.forEach(invoice=>{ const totals=invoiceTotals(invoice,payments); %><article class="table-card mb-3"><h2 class="h4"><%= invoice.student?invoice.student.firstName+' '+invoice.student.lastName:'Student unavailable' %></h2><p><%= invoice.year %> · Term <%= invoice.term %></p>
<table class="table"><thead><tr><th>Fee</th><th class="text-end">Amount (KSh)</th></tr></thead><tbody><% invoice.items.forEach(item=>{ %><tr><td><%= item.label %></td><td class="text-end"><%= item.amount.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td></tr><% }) %></tbody></table>
<div class="d-flex flex-wrap gap-4"><span>Invoiced: <strong>KSh <%= totals.total.toLocaleString('en-KE') %></strong></span><span>Verified paid: <strong>KSh <%= totals.paid.toLocaleString('en-KE') %></strong></span><span>Balance: <strong>KSh <%= totals.balance.toLocaleString('en-KE') %></strong></span></div>
<% if(!staff) { %><a href="/parent/payments?invoice=<%= invoice._id %>" class="btn btn-outline-primary mt-3">Record payment</a><% } %></article><% }) %>
</section><%- include('../partials/footer') %>
