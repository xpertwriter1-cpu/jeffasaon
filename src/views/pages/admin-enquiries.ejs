<%- include('../partials/header') %><section class="container section"><h1>Parent enquiries</h1><a href="/admin/dashboard">School dashboard</a>
<% if(!emailReady){ %><div class="alert alert-warning mt-3">Email delivery is not configured. Enquiries and replies are saved, but queued emails will wait for email setup.</div><% } %>
<p class="mt-3">Unread enquiries have a New message badge. Open an enquiry to read it and reply. Showing the latest 100 enquiries.</p>
<div class="row g-3"><% enquiries.forEach(e=>{ %><div class="col-lg-6"><article class="table-card h-100"><h2 class="h4"><%= e.parentName %> <% if(!e.readAt&&e.status!=='Closed'){ %><span class="badge bg-danger">New message</span><% } %></h2><p class="small"><%= e.email %> ? <%= e.phone %> ? <%= e.status %></p><p class="report-comments"><%= e.message %></p><a class="btn btn-primary" href="/admin/enquiries/<%= e._id %>">Read and reply</a></article></div><% }) %></div><% if(!enquiries.length){ %><p>No enquiries yet.</p><% } %></section><%- include('../partials/footer') %>
