<%- include('../partials/header') %><section class="container section"><h1>Payment verification</h1><div class="d-flex gap-3 mb-4"><a href="/admin/dashboard">Dashboard</a><a href="/admin/fees">Term invoices and balances</a></div>
<p>Check the school's M-Pesa, bank or cash records before marking a payment as paid. Refunded payments are excluded from balances.</p>
<div class="table-card table-responsive"><table class="table align-middle"><thead><tr><th>Parent / student</th><th>Amount / term</th><th>Method / reference</th><th>Verification</th></tr></thead><tbody>
<% payments.forEach(p=>{ %><tr><td><%= p.parentName %><small class="d-block"><%= p.parentPhone %></small><small class="d-block"><%= p.student?p.student.firstName+' '+p.student.lastName:'Unlinked legacy payment' %></small></td><td>KSh <%= p.amount.toLocaleString('en-KE') %><small class="d-block"><%= p.invoice?p.invoice.year+' Term '+p.invoice.term:'Not assigned to an invoice' %></small></td><td><%= p.method %><small class="d-block"><%= p.reference||'No reference' %></small><% if(p.status==='Paid') { %><a href="/admin/payments/<%= p._id %>/receipt">Receipt</a><% } %></td><td><form method="post" action="/admin/payments/<%= p._id %>/status"><input type="hidden" name="_csrf" value="<%= recordToken %>"><label class="visually-hidden" for="status-<%= p._id %>">Payment status</label><select id="status-<%= p._id %>" name="status" class="form-select form-select-sm"><% ['Pending verification','Paid','Failed','Refunded'].forEach(status=>{ %><option <%= p.status===status?'selected':'' %>><%= status %></option><% }) %></select><label class="small d-block my-2"><input type="checkbox" name="confirmReceived" value="yes"> I checked and confirmed receipt of funds</label><button class="btn btn-sm btn-primary">Save status</button></form></td></tr><% }) %>
</tbody></table><% if(!payments.length) { %><p>No payments recorded.</p><% } %></div></section><%- include('../partials/footer') %>
