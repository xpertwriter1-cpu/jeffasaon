<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | <%= school.name %></title><meta name="description" content="Jeffersons Preschool, Rongai, Kenya. A caring place for young minds to learn, play and grow."><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/styles.css" rel="stylesheet"><link href="/css/print.css" rel="stylesheet"></head><body><div class="top-strip"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>📍 <%= school.location %></span><span>☎ <%= school.phone %> · ✉ <%= school.email %></span></div></div><nav class="navbar navbar-expand-lg bg-white sticky-top shadow-sm"><div class="container"><a class="navbar-brand" href="/"><span class="brand-mark">J</span><span>Jeffersons <small>Preschool</small></span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu" aria-controls="nav" aria-expanded="false"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><li class="nav-item"><a class="nav-link" href="/#home">Home</a></li><li class="nav-item"><a class="nav-link" href="/#about">About</a></li><li class="nav-item"><a class="nav-link" href="/#programs">Programmes</a></li><li class="nav-item"><a class="nav-link" href="/#admissions">Admissions</a></li><li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li><% if(currentUser && currentUser.role==='admin'){ %><li class="nav-item"><a class="nav-link" href="/admin/enquiries">Enquiries <span id="enquiryUnreadBadge" class="badge bg-danger" role="status" aria-live="polite" hidden>0</span></a></li><script src="/js/enquiry-notifications.js" defer></script><% } %><% if(currentUser){ %><li class="nav-item"><a class="btn btn-outline-primary btn-sm rounded-pill" href="<%= currentUser.role==='parent'?'/parent/dashboard':'/admin/dashboard' %>">My portal</a></li><li class="nav-item"><form action="/auth/logout" method="post"><input type="hidden" name="_security" value="<%= typeof securityToken !== 'undefined' ? securityToken : '' %>"><button class="btn btn-link nav-link">Sign out</button></form></li><% }else{ %><li class="nav-item"><a class="nav-link" href="/auth/login">Sign in</a></li><li class="nav-item"><a class="btn btn-primary rounded-pill" href="/auth/register">Parent portal</a></li><% } %></ul></div></div></nav><main><% if(flash){ %><div class="container mt-3"><div class="alert alert-<%= flash.type %>"><%= flash.message %></div></div><% } %>
