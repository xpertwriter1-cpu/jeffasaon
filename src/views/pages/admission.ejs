<%- include('../partials/header') %><section class="container section narrow-wide">
<span class="eyebrow">Student admission</span><h1>Your child's admission record</h1><p>Complete the child's details and upload any available supporting documents. Fields marked * are required. The school will review the application.</p>
<% if(errors.length) { %><div class="alert alert-danger" role="alert"><strong>Please check the following:</strong><ul class="mb-0"><% errors.forEach(error=>{ %><li><%= error %></li><% }) %></ul><p class="mb-0 mt-2">Your entered details are retained. Documents are optional. If you wish to attach files, please select them again before resubmitting.</p></div><% } %>
<form method="post" action="/parent/admission" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= admissionToken %>">
<% groups.forEach(group=>{ %><fieldset class="form-card mb-4"><legend class="h4 float-none w-auto px-2"><%= group.title %></legend><% if(group.title==='Parents and guardians') { %><p class="small">This child's parent portal is linked to your signed-in account: <strong><%= currentUser.email %></strong>.</p><% } %><div class="row g-3">
<% group.fields.forEach(field=>{ %><div class="<%= field.type==='textarea'?'col-12':'col-md-6' %>"><label for="<%= field.name %>" class="form-label"><%= field.label %><%= field.required?' *':'' %></label>
<% if(field.options) { %><select id="<%= field.name %>" name="<%= field.name %>" class="form-select" <%= field.required?'required':'' %>><option value="">Choose</option><% field.options.forEach(option=>{ %><option <%= values[field.name]===option?'selected':'' %>><%= option %></option><% }) %></select>
<% } else if(field.type==='textarea') { %><textarea id="<%= field.name %>" name="<%= field.name %>" class="form-control" rows="3" maxlength="<%= field.max||200 %>"><%= values[field.name]||'' %></textarea>
<% } else { %><input id="<%= field.name %>" name="<%= field.name %>" class="form-control" type="<%= field.type||'text' %>" maxlength="<%= field.max||200 %>" value="<%= values[field.name]||'' %>" <%= field.required?'required':'' %> <% if(field.type==='date') { %>min="1900-01-01" max="<%= field.name==='dateOfBirth'?today:'2100-12-31' %>"<% } %>><% } %>
</div><% }) %></div></fieldset><% }) %>
<fieldset class="form-card mb-4"><legend class="h4 float-none w-auto px-2">Supporting documents</legend><p>Optional: attach the records you have available. Each file may be up to <strong>5 MB</strong>. Records accept PDF, JPG or PNG; the child photo accepts JPG or PNG.</p><div class="row g-3">
<% documentTypes.forEach(doc=>{ %><div class="col-md-6"><label for="<%= doc.name %>" class="form-label"><%= doc.label %></label><input id="<%= doc.name %>" name="<%= doc.name %>" type="file" class="form-control" accept="<%= doc.photo?'.jpg,.jpeg,.png':'.pdf,.jpg,.jpeg,.png' %>"></div><% }) %></div><p class="small mt-3 mb-0">Uploaded records are private and accessible to your account and authorised school admins and teachers.</p></fieldset>
<div class="form-card"><label class="d-flex gap-2 align-items-start" for="declaration"><input id="declaration" type="checkbox" name="declaration" value="yes" class="mt-2" required><span>I confirm that I am the child's parent or authorised guardian, that the information is accurate to the best of my knowledge, and that I authorise the school to use these records for admission and the child's care.</span></label><button class="btn btn-primary rounded-pill mt-3">Submit admission record</button></div>
</form></section><%- include('../partials/footer') %>
