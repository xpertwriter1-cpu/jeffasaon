PORT=3000
NODE_ENV=development
DATABASE_URL=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/jeffersons_preschool?retryWrites=true&w=majority
SESSION_SECRET=replace_this_with_a_long_random_secret
SCHOOL_NAME=Jeffersons Preschool
SCHOOL_PHONE=0729 323301
SCHOOL_EMAIL=jeffersonspreschool@gmail.com
SCHOOL_LOCATION=Exciting, Rongai, Kenya
# manual = parents record payments for the bursar to verify.
# mpesa  = also offer M-PESA STK Push with automatic confirmation (configure DARAJA_* below).
PAYMENT_MODE=manual

# Sandbox testing only; live M-Pesa collection is not enabled by this integration.
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Public HTTPS origin forwarding to this app, with no path or trailing slash.
MPESA_CALLBACK_BASE_URL=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
ENQUIRY_NOTIFY_EMAIL=

# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
# Required only when running npm run seed; use a unique password.
SEED_ADMIN_PASSWORD=

# Live M-PESA (Daraja STK Push). Requires PAYMENT_MODE=mpesa.
# DARAJA_ENV=sandbox rehearses the flow without changing balances; set production when Safaricom approves go-live.
DARAJA_ENV=sandbox
DARAJA_SHORTCODE=
# Till (Buy Goods): set DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline and DARAJA_PARTY_B to the till number.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
# Public HTTPS origin of this app with no path, e.g. https://portal.jeffersonspreschool.ac.ke
DARAJA_CALLBACK_BASE_URL=

# Parent notifications. Channels used for automatic alerts (absence, collection, incidents, receipts).
PARENT_ALERT_CHANNELS=sms,email
# SMS through Africa's Talking (use AT_USERNAME=sandbox for testing).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# WhatsApp Cloud API (Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Secret used to hash authorised collectors' ID numbers. Set once and never change it.
PICKUP_ID_SECRET=
