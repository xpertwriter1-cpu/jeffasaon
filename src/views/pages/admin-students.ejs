<%- include('../partials/header') %><section class="container section"><h1>Student register</h1><% if(currentUser.role==='admin') { %><p><a class="btn btn-primary" href="/admin/admissions">Admission approvals</a></p><% } %><a href="/admin/dashboard">← Dashboard</a><div class="table-card mt-4 table-responsive"><table class="table align-middle"><thead><tr><th>Child</th><th>Programme</th><th>Parent contact</th><th>Admission no.</th><th>Status</th></tr></thead><tbody><% students.forEach(st=>{ %><tr><td><% if(['admin','teacher'].includes(currentUser.role)) { %><a href="/admin/students/<%= st._id %>"><%= st.firstName %> <%= st.lastName %></a><small class="d-block">View full admission record</small><% } else { %><%= st.firstName %> <%= st.lastName %><% } %></td><td><%= st.classLevel %></td><td><%= st.parentName %><small class="d-block"><%= st.parentEmail %> · <%= st.parentPhone %></small></td><td><%= st.admissionNumber||'—' %></td><td><% if(currentUser.role === 'admin') { %><form method="post" action="/admin/students/<%= st._id %>/status" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= admissionToken %>"><select name="status" class="form-select form-select-sm"><% [st.status,...({Pending:['Withdrawn'],Admitted:['Active','Withdrawn'],Active:['Graduated','Withdrawn']}[st.status]||[])].forEach(x=>{ %><option <%= st.status===x?'selected':'' %>><%= x %></option><% }) %></select><button class="btn btn-sm btn-primary">Save</button></form><% } else { %><%= st.status %><% } %></td></tr><% }) %></tbody></table><% if(!students.length){ %><p>No applications yet.</p><% } %></div></section><%- include('../partials/footer') %>
